<% layout('layout') %>
<h1><%= it.title %></h1>
<form method="get" action="/" class="filters" role="search">
  <input type="search" name="q" value="<%= it.q %>" placeholder="Search notes" aria-label="Search notes">
  <select name="tag" aria-label="Tag"><option value="">All tags</option>
    <% for (const t of it.tags) { %><option<%= it.f.values.tag === t ? ' selected' : '' %>><%= t %></option><% } %></select>
  <select name="status" aria-label="Status"><option value="">Any status</option>
    <% for (const s of ['draft', 'scheduled', 'published']) { %><option<%= it.f.values.status === s ? ' selected' : '' %>><%= s %></option><% } %></select>
  <input type="text" name="author" value="<%= it.f.values.author || '' %>" placeholder="Author" aria-label="Author" size="10">
  <select name="sort" aria-label="Sort by">
    <% for (const o of it.sort.options) { %><option value="<%= o.value %>"<%= o.selected && it.req.query.sort ? ' selected' : '' %>><%= o.label %></option><% } %></select>
  <button type="submit">Search</button>
</form>
<% if (it.f.active.length) { %><p class="active-filters">Filters: <% for (const a of it.f.active) { %><a href="<%= a.removeHref %>" title="Remove filter"><%= a.label %>: <%= a.value %> &times;</a> <% } %></p><% } %>
<% if (it.suggestion) { %><p class="did-you-mean">Did you mean <a href="<%= it.url({ q: it.suggestion, page: null }) %>"><%= it.suggestion %></a>?</p><% } %>
<% if (!it.rows.length) { %><p>No notes found.</p><% } else { %>
<table class="grid">
<thead><tr>
  <th><a href="<%= it.sort.link('title') %>">Title <%= it.sort.arrow('title') %></a></th><th>Author</th><th>Tag</th><th>Status</th>
  <th><a href="<%= it.sort.link('likes', 'desc') %>">Likes <%= it.sort.arrow('likes') %></a></th>
  <th><a href="<%= it.sort.link('created', 'desc') %>">Created <%= it.sort.arrow('created') %></a></th>
</tr></thead>
<tbody>
<% for (const r of it.rows) { %><tr>
  <td><a href="/notes/<%= r.id %>"><%= r.title %></a><div class="muted"><%~ it.searching ? it.mark(r.snip) : it.h(r.snip) %></div></td>
  <td><a href="<%= it.url({ author: r.username, page: null }) %>"><%= r.username %></a></td><td><%= r.tag %></td><td><%= r.status %></td><td><%= r.likes %></td><td><%= it.fmt.date(r.created_at) %></td>
</tr><% } %>
</tbody></table>
<% } %>
<%~ include('kit/pagination', { p: it.pager }) %>
