<%/* include('kit/field', {name, label, value, error, type: 'text'|'textarea'|'select'|'checkbox'|..., options: [[value,label]], required, attrs}) */%>
<% const id = 'f-' + it.name; const t = it.type || 'text'; %>
<div class="kit-field<%= it.error ? ' has-error' : '' %>">
<% if (t === 'checkbox') { %>
  <label><input type="checkbox" id="<%= id %>" name="<%= it.name %>" value="1"<%= it.value ? ' checked' : '' %>> <%= it.label %></label>
<% } else { %>
  <label for="<%= id %>"><%= it.label %><% if (it.required) { %> <span class="req" aria-hidden="true">*</span><% } %></label>
  <% if (t === 'textarea') { %><textarea id="<%= id %>" name="<%= it.name %>" rows="<%= it.rows || 6 %>"<%= it.required ? ' required' : '' %>><%= it.value ?? '' %></textarea>
  <% } else if (t === 'select') { %><select id="<%= id %>" name="<%= it.name %>"<%= it.required ? ' required' : '' %>>
    <% for (const o of it.options || []) { const [v, l] = Array.isArray(o) ? o : [o, o]; %><option value="<%= v %>"<%= String(v) === String(it.value ?? '') ? ' selected' : '' %>><%= l %></option><% } %>
  </select>
  <% } else { %><input type="<%= t %>" id="<%= id %>" name="<%= it.name %>" value="<%= it.value ?? '' %>"<%= it.required ? ' required' : '' %><%~ it.attrs || '' %>><% } %>
<% } %>
<% if (it.error) { %><div class="kit-error" role="alert"><%= it.error %></div><% } %>
</div>
