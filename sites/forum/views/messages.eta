<% layout('layout') %>
<h1>Messages</h1>
<% if (!it.rows.length) { %><p class="empty">You have no messages. To start a conversation, open a user's profile and choose "Send message".</p><% } %>
<ul class="thread-list">
<% for (const t of it.rows) { %><li class="thread-list__item<%= t.unread ? ' unread' : '' %>">
  <a href="/messages/thread/<%= t.id %>" class="thread-list__subject"><%= t.subject || 'Conversation' %></a><% if (t.unread) { %> <span class="badge"><%= t.unread %> new</span><% } %>
  <p class="muted">With <%= t.others || 'nobody' %> · <%= t.n %> message<%= t.n === 1 ? '' : 's' %> · last from <%= t.last_from %> <%~ it.time(t.last_at) %></p>
  <p class="thread-list__preview"><%= it.F.excerpt(t.last_body, 140) %></p>
</li><% } %>
</ul>
<%~ include('_pager', { p: it.p }) %>
