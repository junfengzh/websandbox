<% layout('layout') %>
<section class="error-page">
  <h1><%= it.status === 404 ? 'Page not found' : it.status === 403 ? 'Access denied' : it.status === 401 ? 'Login required' : it.status >= 500 ? 'Server error' : 'Error' %></h1>
  <p class="muted">Error <%= it.status %></p>
  <p><%= it.message %></p>
  <p><a href="/">Back to the front page</a><% if (it.status === 401 && !it.user) { %> · <a href="/login">Log in</a><% } %></p>
</section>
