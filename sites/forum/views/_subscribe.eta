<% const g = it.g; const f = it.f; if (g.user) { %><form method="post" action="/f/<%= f.name %>/<%= f.subscribed ? 'unsubscribe' : 'subscribe' %>" class="inline subscribe-form" data-subscribe><%~ g.csrfInput() %><input type="hidden" name="next" value="<%= g.req.url %>"><button type="submit" class="small<%= f.subscribed ? ' secondary' : '' %>" aria-pressed="<%= f.subscribed %>" aria-label="<%= f.subscribed ? 'Unsubscribe from' : 'Subscribe to' %> <%= f.name %>"><%= f.subscribed ? 'Unsubscribe' : 'Subscribe' %></button></form><% } %>
