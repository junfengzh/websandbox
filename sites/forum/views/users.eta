<% layout('layout') %>
<h1>Users</h1>
<table class="grid"><thead><tr><th scope="col">Username</th><th scope="col">Registered</th><th scope="col">Last seen</th></tr></thead><tbody>
<% for (const u of it.rows) { %><tr><td><a href="/user/<%= u.username %>"><%= u.username %></a></td><td><%~ u.created_at > '1971' ? it.time(u.created_at) : 'unknown' %></td><td><%~ it.time(u.last_seen_at) %></td></tr><% } %>
</tbody></table>
<%~ include('_pager', { p: it.p }) %>
