<% layout('layout') %>
<% const e = it.errors; const fld = (name, label, auto) => `<div class="form-group${e[name] ? ' has-error' : ''}"><label for="user_${name}">${label}</label><input class="form-control" type="password" id="user_${name}" name="${name}" autocomplete="${auto}" required>${e[name] ? `<p class="invalid-feedback">${it.h(e[name])}</p>` : ''}</div>`; %>
<section class="settings-layout">
  <div><h1 style="font-size:1.15rem;margin:0">Password</h1><p class="muted">After a successful password update, you will be redirected to the login page where you can log in with your new password.</p></div>
  <form method="post" action="/-/profile/password" aria-label="Change your password" style="max-width:480px">
    <%~ it.csrfInput() %>
    <%~ fld('current_password', 'Current password', 'current-password') %>
    <%~ fld('new_password', 'New password', 'new-password') %>
    <%~ fld('password_confirmation', 'Password confirmation', 'new-password') %>
    <button type="submit" class="btn btn-confirm">Save password</button>
  </form>
</section>
