<% layout('layout') %>
<div class="page-title-row"><h1>Activity</h1></div>
<div class="top-area">
  <nav aria-label="Activity scope"><ul class="nav-tabs">
    <li><a href="/dashboard/activity"<%~ it.scope === 'projects' ? ' aria-current="page"' : '' %>>Your projects</a></li>
    <li><a href="/dashboard/activity?scope=starred"<%~ it.scope === 'starred' ? ' aria-current="page"' : '' %>>Starred projects</a></li>
    <li><a href="/dashboard/activity?scope=mine"<%~ it.scope === 'mine' ? ' aria-current="page"' : '' %>>Your activity</a></li>
  </ul></nav>
</div>
<nav aria-label="Event filter"><ul class="nav-tabs">
  <% for (const [k, l] of [['all', 'All'], ['push', 'Push events'], ['merged', 'Merge events'], ['issue', 'Issue events'], ['comments', 'Comments'], ['wiki', 'Wiki'], ['team', 'Team']]) { %>
  <li><a href="<%= it.url({ filter: k === 'all' ? null : k, page: null }) %>"<%~ it.filter === k ? ' aria-current="page"' : '' %>><%= l %></a></li><% } %>
</ul></nav>
<% if (!it.events.length) { %><div class="empty-state"><h3>No activity</h3><p>Activity in your projects shows up here.</p></div><% } else { %>
<ul class="event-list"><% for (const e of it.events) { %><%~ include('_event', { e, time: it.time, avatar: it.avatar }) %><% } %></ul>
<%~ include('_pager', { pager: it.pager }) %>
<% } %>
