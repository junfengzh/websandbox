<% const c = it.c, p = it.p; if (c) { %>
<div class="last-commit">
  <%~ it.avatar({ id: (c.author_email || '').length, name: c.author_name }, 32) %>
  <div class="commit-info">
    <a class="commit-title" href="/<%= p.full_path %>/-/commit/<%= c.sha %>"><%= c.title %></a>
    <div class="muted"><span class="commit-author"><%= c.author_name %></span> authored <%~ it.time(c.authored_at || c.committed_at) %></div>
  </div>
  <div class="commit-sha-group">
    <a class="btn btn-sm commit-sha" href="/<%= p.full_path %>/-/commit/<%= c.sha %>" title="<%= c.sha %>"><%= c.sha.slice(0, 8) %></a>
    <button type="button" class="btn btn-sm" data-clipboard-text="<%= c.sha %>" title="Copy commit SHA" aria-label="Copy commit SHA"><svg class="i" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg></button>
  </div>
</div>
<% } %>
