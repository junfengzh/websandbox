<% layout('layout') %>
<%
  const v = it.values || {}, e = it.errors || {};
  const mode = v.mode || (v.template ? 'template' : (it.req.query.mode || 'blank'));
%>
<div class="page-title-row"><h1>Create new project</h1></div>
<nav aria-label="Project creation"><ul class="nav-tabs">
  <li><a href="/projects/new#blank_project"<%~ mode === 'blank' ? ' aria-current="page"' : '' %> data-mode="blank" onclick="document.getElementById('mode-blank').checked=true;document.getElementById('mode-blank').dispatchEvent(new Event('change',{bubbles:true}));return false;">Create blank project</a></li>
  <li><a href="/projects/new?mode=template#create_from_template"<%~ mode === 'template' ? ' aria-current="page"' : '' %> onclick="document.getElementById('mode-template').checked=true;document.getElementById('mode-template').dispatchEvent(new Event('change',{bubbles:true}));return false;">Create from template</a></li>
</ul></nav>
<form method="post" action="/projects" class="new-project-form" aria-label="New project" style="max-width:820px;margin-top:16px">
  <%~ it.csrfInput() %>
  <fieldset><legend class="sr-only">How to create the project</legend>
    <label style="margin-right:16px"><input type="radio" id="mode-blank" name="mode" value="blank"<%= mode !== 'template' ? ' checked' : '' %>> Blank project</label>
    <label><input type="radio" id="mode-template" name="mode" value="template"<%= mode === 'template' ? ' checked' : '' %>> From a template</label>
  </fieldset>
  <fieldset id="template-picker" class="card"<%= mode === 'template' ? '' : ' hidden' %>>
    <legend class="card-header" style="width:100%">Built-in templates</legend>
    <ul class="content-list" style="padding:0 16px;max-height:420px;overflow:auto">
    <% for (const t of it.templates) { %>
      <li><label style="display:flex;gap:10px;align-items:flex-start;font-weight:400"><input type="radio" name="template" value="<%= t.name %>"<%= v.template === t.name ? ' checked' : '' %>><span><strong><%= t.title %></strong><br><span class="muted"><%= t.description || '' %></span></span></label></li>
    <% } %></ul>
    <% if (e.template) { %><p class="invalid-feedback" style="padding:0 16px"><%= e.template %></p><% } %>
  </fieldset>
  <div class="form-group<%= e.name ? ' has-error' : '' %>"><label for="project_name">Project name</label>
    <input class="form-control" id="project_name" name="name" value="<%= v.name || '' %>" placeholder="My awesome project" required autofocus>
    <% if (e.name) { %><p class="invalid-feedback"><%= e.name %></p><% } %>
    <p class="form-text">Must start with a lowercase or uppercase letter, digit, emoji, or underscore. Can also contain dots, pluses, dashes, or spaces.</p></div>
  <div class="row">
    <div class="col form-group<%= e.namespace_id ? ' has-error' : '' %>"><label for="project_namespace_id">Project URL</label>
      <div class="input-group"><span class="input-group-text">/</span><select class="form-control" id="project_namespace_id" name="namespace_id">
      <% for (const t of it.targets) { %><option value="<%= t.id %>"<%= String(t.id) === String(v.namespace_id) ? ' selected' : '' %>><%= t.full_path %><%= t.kind === 'user' ? ' (personal)' : '' %></option><% } %>
      </select></div><% if (e.namespace_id) { %><p class="invalid-feedback"><%= e.namespace_id %></p><% } %></div>
    <div class="col form-group<%= e.path ? ' has-error' : '' %>"><label for="project_path">Project slug</label><input class="form-control" id="project_path" name="path" value="<%= v.path || '' %>" placeholder="my-awesome-project">
      <% if (e.path) { %><p class="invalid-feedback">Project slug <%= e.path %></p><% } %></div>
  </div>
  <div class="form-group"><label for="project_description">Project description (optional)</label><textarea class="form-control" id="project_description" name="description" rows="3"><%= v.description || '' %></textarea></div>
  <fieldset><legend>Visibility Level</legend>
    <ul class="radio-list">
    <% for (const [k, l, h] of [['private', 'Private', 'Project access must be granted explicitly to each user. If this project is part of a group, access is granted to members of the group.'], ['internal', 'Internal', 'The project can be accessed by any logged in user.'], ['public', 'Public', 'The project can be accessed without any authentication.']]) { %>
      <li><label><input type="radio" name="visibility" value="<%= k %>"<%= (v.visibility || 'private') === k ? ' checked' : '' %>> <%= l %></label><div class="help"><%= h %></div></li>
    <% } %></ul>
  </fieldset>
  <fieldset id="blank-options"<%= mode === 'template' ? ' hidden' : '' %>><legend>Project Configuration</legend>
    <label style="font-weight:400"><input type="checkbox" name="readme" value="1"<%= v.readme ? ' checked' : '' %>> <strong>Initialize repository with a README</strong></label>
    <p class="form-text">Allows you to immediately clone this project's repository. Skip this if you plan to push up an existing repository.</p>
  </fieldset>
  <div class="form-actions"><button type="submit" class="btn btn-confirm">Create project</button><a class="btn" href="/dashboard/projects">Cancel</a></div>
</form>
<script>
(function () {
  var f = document.querySelector('.new-project-form');
  function sync() { var t = document.getElementById('mode-template').checked; document.getElementById('template-picker').hidden = !t; document.getElementById('blank-options').hidden = t; }
  f.addEventListener('change', function (e) { if (e.target.name === 'mode') sync(); });
  var name = document.getElementById('project_name'), path = document.getElementById('project_path'), touched = !!path.value;
  path.addEventListener('input', function () { touched = true; });
  name.addEventListener('input', function () { if (!touched) path.value = name.value.trim().toLowerCase().replace(/[^a-z0-9_.-]+/g, '-').replace(/^[-.]+|[-.]+$/g, '').replace(/-{2,}/g, '-'); });
  if (location.hash === '#create_from_template') { document.getElementById('mode-template').checked = true; sync(); }
})();
</script>
