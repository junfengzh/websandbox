<% layout('layout') %>
<div class="page-title-row"><h1>Users</h1></div>
<form method="get" class="filter-bar" role="search" aria-label="Search users">
  <label class="sr-only" for="user-search">Search users</label>
  <input type="search" id="user-search" name="search" value="<%= it.q %>" placeholder="Search by name or username">
  <select name="sort" aria-label="Sort by" data-autosubmit>
    <% for (const [v, l] of [['name_asc', 'Name'], ['username_asc', 'Username'], ['created_desc', 'Recently joined'], ['created_asc', 'Oldest joined']]) { %><option value="<%= v %>"<%= it.sort.value === v ? ' selected' : '' %>><%= l %></option><% } %>
  </select>
  <button class="btn" type="submit">Search</button>
</form>
<p class="muted"><%= it.plural(it.pager.total, 'user') %></p>
<ul class="user-list">
<% for (const u of it.rows) { %>
  <li class="user-card"><%~ it.avatar(u, 40) %><div><a class="name" href="/<%= u.username %>"><%= u.name %></a><div class="username">@<%= u.username %></div></div></li>
<% } %>
</ul>
<%~ include('_pager', { pager: it.pager }) %>
