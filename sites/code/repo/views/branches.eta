<% layout('layout') %>
<% const p = it.project, base = '/' + p.full_path, enc = it.enc; %>
<div class="top-area">
  <nav aria-label="Branch filters"><ul class="nav-tabs">
    <% for (const [k, l, h] of [['overview', 'Overview', ''], ['active', 'Active', '/active'], ['stale', 'Stale', '/stale'], ['all', 'All', '/all']]) { %><li><a href="<%= base %>/-/branches<%= h %>"<%~ it.state === k ? ' aria-current="page"' : '' %>><%= l %></a></li><% } %>
  </ul></nav>
  <div class="nav-controls">
    <form method="get" action="<%= base %>/-/branches<%= it.state === 'overview' ? '/all' : '/' + it.state %>" class="filter-bar" role="search" aria-label="Filter branches" style="padding:0">
      <label class="sr-only" for="branch-search">Filter by branch name</label>
      <input type="search" id="branch-search" name="search" value="<%= it.q %>" placeholder="Filter by branch name">
      <% if (it.state !== 'overview') { %><select name="sort" aria-label="Sort by" data-autosubmit><% for (const [v, l] of [['name_asc', 'Name'], ['updated_desc', 'Updated date'], ['updated_asc', 'Oldest updated']]) { %><option value="<%= v %>"<%= it.sort === v ? ' selected' : '' %>><%= l %></option><% } %></select><% } %>
    </form>
    <% if (it.canPush) { %><a class="btn btn-confirm" href="<%= base %>/-/branches/new">New branch</a><% } %>
  </div>
</div>
<h1 class="sr-only">Branches</h1>
<% for (const s of it.sections) { %>
<section style="margin-top:16px" aria-label="<%= s.title %>">
  <h2 style="font-size:1rem"><%= s.title %></h2>
  <% if (!s.rows.length) { %><p class="muted"><%= it.q ? 'No branches match your search.' : 'No branches to show' %></p><% } else { %>
  <ul class="ref-list">
  <% for (const b of s.rows) { const mr = it.mrBy[b.name]; %>
    <li class="ref-row branch-row" data-name="<%= b.name %>">
      <div class="ref-main">
        <a class="ref-title" href="<%= base %>/-/tree/<%= enc(b.name) %>"><%= b.name %></a>
        <button type="button" class="btn-link" data-clipboard-text="<%= b.name %>" title="Copy branch name" aria-label="Copy branch name <%= b.name %>"><svg class="i" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg></button>
        <% if (b.isDefault) { %><span class="badge badge-info">default</span><% } %><% if (b.protected) { %><span class="badge badge-success">protected</span><% } %>
        <div class="ref-commit"><a class="commit-sha" href="<%= base %>/-/commit/<%= b.sha %>"><%= b.sha.slice(0, 8) %></a> · <%= b.title || '' %> · <%~ it.time(b.committed_at) %></div>
      </div>
      <div class="btn-group" style="gap:6px">
        <% if (mr) { %><a class="btn btn-sm" href="<%= base %>/-/merge_requests/<%= mr.iid %>">!<%= mr.iid %></a><% } else if (!b.isDefault && it.user) { %><a class="btn btn-sm" href="<%= base %>/-/merge_requests/new?merge_request%5Bsource_branch%5D=<%= encodeURIComponent(b.name) %>">Merge request</a><% } %>
        <% if (!b.isDefault) { %><a class="btn btn-sm" href="<%= base %>/-/compare/<%= enc(p.default_branch) %>...<%= enc(b.name) %>">Compare</a><% } %>
        <% if (it.canPush && !b.isDefault && (!b.protected || it.canAdmin)) { %>
        <form method="post" action="<%= base %>/-/branches/delete" data-confirm="You're about to permanently delete the branch <%= b.name %>. Are you sure?"><%~ it.csrfInput() %><input type="hidden" name="branch_name" value="<%= b.name %>"><input type="hidden" name="next" value="<%= it.req.url %>"><button type="submit" class="btn btn-sm btn-danger-secondary" aria-label="Delete branch <%= b.name %>" title="Delete branch">Delete</button></form>
        <% } %>
      </div>
    </li>
  <% } %>
  </ul>
  <% if (s.more) { %><p><a href="<%= base %>/-/branches/<%= s.more %>">Show more <%= s.more %> branches</a></p><% } %>
  <% if (s.pager) { %><%~ include('_pager', { pager: s.pager }) %><% } %>
  <% } %>
</section>
<% } %>
