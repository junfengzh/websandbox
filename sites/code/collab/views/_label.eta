<%/* include('collab/_label', {l, href, U}) : one label pill (scoped labels "a::b" in two parts) */%>
<% const l = it.l, fg = it.U.labelText(l.color), i = l.title.lastIndexOf('::'); %>
<% if (i > 0) { %><<%= it.href ? 'a' : 'span' %> class="gl-label scoped"<% if (it.href) { %> href="<%= it.href %>"<% } %> style="background:<%= l.color %>;color:<%= fg %>;border-color:<%= l.color %>" title="<%= l.description || l.title %>"><span class="scope-key"><%= l.title.slice(0, i) %></span><span class="scope-value"><%= l.title.slice(i + 2) %></span></<%= it.href ? 'a' : 'span' %>><% } else { %><<%= it.href ? 'a' : 'span' %> class="gl-label"<% if (it.href) { %> href="<%= it.href %>"<% } %> style="background:<%= l.color %>;color:<%= fg %>" title="<%= l.description || l.title %>"><%= l.title %></<%= it.href ? 'a' : 'span' %>><% } %>
