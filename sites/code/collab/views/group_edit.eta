<% layout('layout') %>
<% const X = it, G = it.group, v = it.values || {}, e = it.errors || {}; %>
<h1>General settings</h1>
<% if (Object.keys(e).length) { %><div class="flash flash-alert" role="alert"><ul><% for (const k in e) { %><li><%= e[k] %></li><% } %></ul></div><% } %>
<section class="settings-section"><h2>Naming, visibility</h2><p class="lead">Update your group name, description, avatar, and visibility.</p>
<form method="post" action="<%= G.base %>/-/edit" style="max-width:760px"><%~ X.csrfInput() %>
  <div class="row"><div class="col form-group"><label for="g_name">Group name</label><input class="form-control" type="text" id="g_name" name="name" value="<%= v.name %>" required></div>
  <div class="col form-group"><label for="g_id">Group ID</label><input class="form-control" type="text" id="g_id" value="<%= G.id %>" readonly></div></div>
  <div class="form-group"><label for="g_desc">Group description (optional)</label><textarea class="form-control" id="g_desc" name="description" rows="3"><%= v.description || '' %></textarea></div>
  <fieldset><legend>Visibility level</legend><ul class="radio-list"><% for (const [k, l] of [['private', 'Private'], ['internal', 'Internal'], ['public', 'Public']]) { %><li><label><input type="radio" name="visibility" value="<%= k %>"<%~ v.visibility === k ? ' checked' : '' %>> <%= l %></label></li><% } %></ul></fieldset>
  <input type="hidden" name="request_access_enabled" value="0"><label class="gap8" style="font-weight:400"><input type="checkbox" name="request_access_enabled" value="1"<%~ v.request_access_enabled ? ' checked' : '' %>> Allow users to request access (if visibility is public or internal)</label>
  <div class="form-actions"><button class="btn btn-confirm" type="submit">Save changes</button></div>
</form></section>
<section class="settings-section"><h2>Change group URL</h2><p class="lead">Changing a group's URL can have unintended side effects.</p>
<form method="post" action="<%= G.base %>/-/transfer_path" class="gap8"><%~ X.csrfInput() %><label class="sr-only" for="g_path">Group URL</label><span class="muted">/<%= G.full_path.split('/').slice(0, -1).join('/') %></span><input type="text" id="g_path" name="path" value="<%= G.path %>" required><button class="btn btn-danger-secondary" type="submit">Change group URL</button></form></section>
<section class="settings-section danger-zone"><h3>Remove group</h3><p>Removing this group also removes all child projects, including archived projects, and their resources.</p>
<form method="post" action="<%= G.base %>/-/delete"><%~ X.csrfInput() %><label for="g_confirm">Enter <code><%= G.full_path %></code> to confirm:</label><br><input type="text" id="g_confirm" name="confirm_name" autocomplete="off" required> <button class="btn btn-danger" type="submit">Remove group</button></form></section>
