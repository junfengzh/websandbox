<% const l = it.list; %>
<div class="block filter" id="layered-filter-block" role="region" aria-label="Shopping Options">
  <% if (l.active.length) { %>
  <div class="filter-current"><strong class="block-subtitle filter-current-subtitle">Now Shopping by</strong>
    <ol class="items"><% for (const a of l.active) { %><li class="item"><span class="filter-label"><%= a.label %></span>: <span class="filter-value"><%= a.value %></span> <a class="action remove" href="<%= a.removeHref %>" title="Remove <%= a.label %> <%= a.value %>"><span>Remove This Item</span></a></li><% } %></ol>
    <div class="block-actions filter-actions"><a href="<%= l.clearAll %>" class="action clear filter-clear"><span>Clear All</span></a></div>
  </div>
  <% } %>
  <% if (l.facets.length) { %>
  <strong role="heading" aria-level="2" class="block-subtitle filter-subtitle">Shopping Options</strong>
  <dl class="filter-options" id="narrow-by-list">
  <% for (const f of l.facets) { %>
    <dt role="heading" aria-level="3" class="filter-options-title"><%= f.label %></dt>
    <dd class="filter-options-content"><ol class="items">
    <% for (const x of f.items) { %><li class="item"><a href="<%= x.href %>"><% if (f.swatch && x.swatch) { %><span class="swatch-mini" style="background:<%= x.swatch %>"></span><% } %><%~ it.htmlName(x.label) %> <span class="count"><%= x.count %><span class="filter-count-label"> item<%= x.count === 1 ? '' : 's' %></span></span></a></li><% } %>
    </ol><% if (f.more) { %><p class="muted">and <%= f.more %> more brands — search to narrow down</p><% } %></dd>
  <% } %>
  </dl>
  <% } %>
</div>
