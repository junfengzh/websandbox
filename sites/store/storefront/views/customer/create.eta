<% layout('layout') %>
<form class="form create account form-create-account" action="/customer/account/createpost/" method="post" id="form-validate" autocomplete="off">
  <%~ it.csrfInput() %>
  <fieldset class="fieldset create info"><legend class="legend"><span>Personal Information</span></legend>
    <%~ include('_field', { ...it, name: 'firstname', label: 'First Name', value: it.values.firstname, required: true }) %>
    <%~ include('_field', { ...it, name: 'lastname', label: 'Last Name', value: it.values.lastname, required: true }) %>
    <div class="field choice newsletter"><input type="checkbox" name="is_subscribed" title="Sign Up for Newsletter" value="1" id="is_subscribed" class="checkbox"<%= it.values.is_subscribed ? ' checked' : '' %>> <label for="is_subscribed" class="label"><span>Sign Up for Newsletter</span></label></div>
  </fieldset>
  <fieldset class="fieldset create account"><legend class="legend"><span>Sign-in Information</span></legend>
    <%~ include('_field', { ...it, name: 'email', label: 'Email', value: it.values.email, required: true, type: 'email', autocomplete: 'email' }) %>
    <%~ include('_field', { ...it, name: 'password', label: 'Password', value: '', required: true, type: 'password', autocomplete: 'new-password' }) %>
    <%~ include('_field', { ...it, name: 'password_confirmation', label: 'Confirm Password', value: '', required: true, type: 'password', autocomplete: 'new-password' }) %>
  </fieldset>
  <div class="actions-toolbar"><div class="primary"><button type="submit" class="action submit primary" title="Create an Account"><span>Create an Account</span></button></div></div>
</form>
