<% layout('admin/layout') %>
<section class="login-box" aria-labelledby="login-title">
  <span class="logo-img" aria-hidden="true">M</span>
  <h1 id="login-title">Welcome, please sign in</h1>
  <% if (it.error) { %><div class="message message-error error" role="alert"><div><%= it.error %></div></div><% } %>
  <form method="post" action="/admin/admin/auth/login/" id="login-form">
    <%~ it.csrfInput() %>
    <input type="hidden" name="next" value="<%= it.next || '' %>">
    <div class="admin__field _required"><div class="admin__field-label"><label for="username">Username</label></div><div class="admin__field-control"><input id="username" class="admin__control-text" type="text" name="login[username]" autocomplete="username" value="<%= it.username || '' %>" required autofocus></div></div>
    <div class="admin__field _required"><div class="admin__field-label"><label for="login">Password</label></div><div class="admin__field-control"><input id="login" class="admin__control-text" type="password" name="login[password]" autocomplete="current-password" required></div></div>
    <div class="actions"><button type="submit" class="action-login action-primary">Sign in</button><a class="action-forgotpassword" href="/admin/admin/auth/forgotpassword/">Forgot your password?</a></div>
  </form>
</section>
