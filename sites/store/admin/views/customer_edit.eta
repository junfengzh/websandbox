<% layout('admin/layout') %>
<% const U = it.U; const c = it.c; const h = it.h; const V = it.values; const E = it.errors || {};
   const F = (f, vals = V, errs = E) => include('admin/partials/field', { ...it, f: { ...f, value: Object.prototype.hasOwnProperty.call(vals, f.name) ? vals[f.name] : f.value, error: errs[f.name] } });
   const addr = (a) => a ? [[a.prefix, a.firstname, a.middlename, a.lastname, a.suffix].filter(Boolean).join(' '), a.company, ...String(a.street || '').split('\n'), [a.city, a.region, a.postcode].filter(Boolean).join(', '), a.country, a.telephone ? 'T: ' + a.telephone : null].filter(Boolean).map((x) => h(x)).join('<br>') : 'The customer does not have default billing address'; %>
<div class="with-side-tabs">
<nav aria-label="Customer Information"><ul class="side-tabs" id="customer_edit_tabs"><li class="tabs-title">Customer Information</li>
<% for (const [l, href, cur] of it.tabs) { %><li><a href="<%= href %>"<%= cur ? ' aria-current="page"' : '' %>><%= l %></a></li><% } %>
</ul></nav>
<div>
<% if (it.tab === 'customer_view' && c) { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Personal Information</h2>
  <div class="admin__page-section-content">
    <table class="admin__table-secondary" id="customer_personal_info"><tbody>
      <tr><th>Customer Name:</th><td><%= it.title %></td></tr><tr><th>Email:</th><td><%= c.email %></td></tr>
      <% if (c.dob) { %><tr><th>Date of Birth:</th><td><%= U.date.medium(c.dob) %></td></tr><% } %>
      <% if (c.gender) { %><tr><th>Gender:</th><td><%= { 1: 'Male', 2: 'Female', 3: 'Not Specified' }[c.gender] %></td></tr><% } %>
      <tr><th>Last Logged In:</th><td><%= it.lastLogin ? U.date.datetime(it.lastLogin) : 'Never (Offline)' %></td></tr>
      <tr><th>Account Lock:</th><td>Unlocked</td></tr><tr><th>Confirmed email:</th><td><%= c.confirmation ? 'Confirmation Required' : 'Confirmation Not Required' %></td></tr>
      <tr><th>Account Created:</th><td><%= U.date.datetime(c.created_at) %></td></tr><tr><th>Account Created in:</th><td><%= c.created_in || 'Default Store View' %></td></tr>
      <tr><th>Customer Group:</th><td><%= it.group %></td></tr>
      <tr><th>Orders:</th><td><%= it.stats.n %> (lifetime sales <%= U.money(it.stats.total) %>)</td></tr>
    </tbody></table>
    <div><h3 class="admin__page-section-item-title">Default Billing Address</h3><address><%~ addr(it.billing) %></address></div>
  </div></section>
<% } else if (it.tab === 'account') { %>
  <form id="customer_form" method="post" action="<%= c ? `/admin/customer/index/save/id/${c.id}/` : '/admin/customer/index/save/' %>" novalidate>
    <%~ it.csrfInput() %>
    <fieldset class="admin__fieldset"><legend>Account Information</legend>
    <div class="admin__field"><div class="admin__field-label"><span>Associate to Website</span></div><div class="admin__field-control">Main Website</div></div>
    <% for (const f of it.accountFields) { %><%~ F(f) %><% } %>
    </fieldset>
    <div class="form-buttons"><button type="submit" class="action-primary">Save Customer</button></div>
  </form>
<% } else if (it.tab === 'addresses') { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Addresses <a class="action-secondary" href="/admin/customer/index/edit/id/<%= c.id %>/active_tab/addresses/#address_form">Add New Address</a></h2>
  <table class="data-grid" id="customer_address_listing"><thead><tr><th>Default</th><th>First Name</th><th>Last Name</th><th>Street Address</th><th>City</th><th>Country</th><th>State/Province</th><th>Zip/Postal Code</th><th>Phone Number</th><th>Actions</th></tr></thead><tbody>
  <% if (!it.addresses.length) { %><tr class="data-grid-tr-no-data"><td colspan="10">The customer does not have addresses.</td></tr><% } %>
  <% for (const a of it.addresses) { %><tr><td><%= [a.id === c.default_billing_id ? 'Default Billing' : null, a.id === c.default_shipping_id ? 'Default Shipping' : null].filter(Boolean).join(', ') %></td>
    <td><%= a.firstname %></td><td><%= a.lastname %></td><td><%= String(a.street || '').replace(/\n/g, ', ') %></td><td><%= a.city %></td><td><%= a.country %></td><td><%= a.region %></td><td><%= a.postcode %></td><td><%= a.telephone %></td>
    <td><a href="/admin/customer/index/edit/id/<%= c.id %>/active_tab/addresses/?address_id=<%= a.id %>#address_form">Edit</a>
      <form method="post" action="/admin/customer/address/default/id/<%= a.id %>/type/billing/" class="inline"><%~ it.csrfInput() %><button type="submit" class="link">Set as default billing</button></form>
      <form method="post" action="/admin/customer/address/default/id/<%= a.id %>/type/shipping/" class="inline"><%~ it.csrfInput() %><button type="submit" class="link">Set as default shipping</button></form>
      <form method="post" action="/admin/customer/address/delete/id/<%= a.id %>/" class="inline" data-confirm="Are you sure you want to delete this address?"><%~ it.csrfInput() %><button type="submit" class="link">Delete</button></form></td></tr><% } %>
  </tbody></table></section>
  <section class="admin__page-section" id="address_form"><h2 class="admin__page-section-title"><%= it.addrId ? 'Edit Address' : 'Add New Address' %></h2>
  <form method="post" action="/admin/customer/address/save/parent_id/<%= c.id %>/" novalidate>
    <%~ it.csrfInput() %>
    <% if (it.addrId) { %><input type="hidden" name="address_id" value="<%= it.addrId %>"><% } %>
    <% const AV = it.addrValues; const AE = it.addrErrors; %>
    <%~ F({ name: 'address[default_billing]', label: 'Default Billing Address', type: 'checkbox' }, AV, AE) %>
    <%~ F({ name: 'address[default_shipping]', label: 'Default Shipping Address', type: 'checkbox' }, AV, AE) %>
    <%~ F({ name: 'address[prefix]', label: 'Name Prefix' }, AV, AE) %><%~ F({ name: 'address[firstname]', label: 'First Name', required: true }, AV, AE) %>
    <%~ F({ name: 'address[middlename]', label: 'Middle Name/Initial' }, AV, AE) %><%~ F({ name: 'address[lastname]', label: 'Last Name', required: true }, AV, AE) %>
    <%~ F({ name: 'address[suffix]', label: 'Name Suffix' }, AV, AE) %><%~ F({ name: 'address[company]', label: 'Company' }, AV, AE) %>
    <%~ F({ name: 'address[street][0]', label: 'Street Address', required: true }, AV, AE) %><%~ F({ name: 'address[street][1]', label: 'Street Address: Line 2' }, AV, AE) %>
    <%~ F({ name: 'address[city]', label: 'City', required: true }, AV, AE) %>
    <%~ F({ name: 'address[country_id]', label: 'Country', type: 'select', options: it.countries, required: true }, AV, AE) %>
    <%~ F({ name: 'address[region_id]', label: 'State/Province', type: 'select', options: it.regions, empty: 'Please select a region, state or province.', note: 'For countries without a list, use the text field below.' }, AV, AE) %>
    <%~ F({ name: 'address[region]', label: 'State/Province (text)' }, AV, AE) %>
    <%~ F({ name: 'address[postcode]', label: 'Zip/Postal Code', required: true }, AV, AE) %><%~ F({ name: 'address[telephone]', label: 'Phone Number', required: true }, AV, AE) %>
    <%~ F({ name: 'address[fax]', label: 'Fax' }, AV, AE) %><%~ F({ name: 'address[vat_id]', label: 'VAT Number' }, AV, AE) %>
    <div class="form-buttons"><button type="submit" class="action-primary">Save Address</button></div>
  </form></section>
<% } else if (it.tab === 'orders') { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Orders</h2>
  <table class="data-grid" id="customer_orders_grid"><thead><tr><th>Order</th><th>Purchased</th><th>Bill-to Name</th><th>Ship-to Name</th><th class="num">Order Total</th><th>Purchase Point</th><th>Status</th></tr></thead><tbody>
  <% if (!it.orders.length) { %><tr class="data-grid-tr-no-data"><td colspan="7">We couldn't find any records.</td></tr><% } %>
  <% for (const o of it.orders) { %><tr><td><a href="/admin/sales/order/view/order_id/<%= o.id %>/"><%= o.increment_id %></a></td><td><%= U.date.datetime(o.created_at) %></td><td><%= o.bill_to %></td><td><%= o.ship_to %></td><td class="num"><%= U.money(o.grand_total) %></td><td>Main Website</td><td><%= o.status_label || o.status %></td></tr><% } %>
  </tbody></table><p class="muted"><%= it.orders.length %> records found</p></section>
<% } else if (it.tab === 'cart') { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Shopping Cart</h2>
  <table class="data-grid"><thead><tr><th>Product</th><th>SKU</th><th class="num">Price</th><th class="num">Qty</th><th class="num">Total</th></tr></thead><tbody>
  <% if (!it.cart.length) { %><tr class="data-grid-tr-no-data"><td colspan="5">There are no items in customer's shopping cart.</td></tr><% } %>
  <% for (const i of it.cart) { %><tr><td><%~ U.htmlName(i.name) %></td><td><%= i.sku %></td><td class="num"><%= U.money(i.price) %></td><td class="num"><%= U.num(i.qty) %></td><td class="num"><%= U.money(i.row_total) %></td></tr><% } %>
  </tbody></table></section>
<% } else if (it.tab === 'newsletter') { %>
  <form id="customer_form" method="post" action="/admin/customer/index/save/id/<%= c.id %>/"><%~ it.csrfInput() %>
  <fieldset class="admin__fieldset"><legend>Newsletter Information</legend>
    <%~ F({ name: 'subscription', label: 'Newsletter Subscription', type: 'checkbox', checkLabel: 'Subscribed to Newsletter', value: it.subscribed ? 1 : 0 }, {}) %>
  </fieldset><div class="form-buttons"><button type="submit" class="action-primary">Save Customer</button></div></form>
<% } else if (it.tab === 'reviews') { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Product Reviews</h2>
  <table class="data-grid" id="customer_reviews_grid"><thead><tr><th>ID</th><th>Created</th><th>Status</th><th>Title</th><th>Nickname</th><th>Review</th><th>Product</th><th>SKU</th><th>Action</th></tr></thead><tbody>
  <% if (!it.reviews.length) { %><tr class="data-grid-tr-no-data"><td colspan="9">We couldn't find any records.</td></tr><% } %>
  <% for (const x of it.reviews) { %><tr><td><%= x.id %></td><td><%= U.date.datetime(x.created_at) %></td><td><%= { approved: 'Approved', pending: 'Pending', not_approved: 'Not Approved' }[x.status] %></td><td><%= x.title %></td><td><%= x.nickname %></td><td><%= String(x.detail || '').slice(0, 120) %></td><td><a href="/admin/catalog/product/edit/id/<%= x.product_id %>/"><%~ U.htmlName(x.name || '') %></a></td><td><%= x.sku %></td><td><a href="/admin/review/product/edit/id/<%= x.id %>/">Edit</a></td></tr><% } %>
  </tbody></table></section>
<% } else if (it.tab === 'wishlist') { %>
  <section class="admin__page-section"><h2 class="admin__page-section-title">Wish List</h2>
  <table class="data-grid"><thead><tr><th>Product</th><th>SKU</th><th class="num">Price</th><th class="num">Qty</th><th>Added</th><th>Comment</th></tr></thead><tbody>
  <% if (!it.wishlist.length) { %><tr class="data-grid-tr-no-data"><td colspan="6">We couldn't find any records.</td></tr><% } %>
  <% for (const i of it.wishlist) { %><tr><td><a href="/admin/catalog/product/edit/id/<%= i.product_id %>/"><%~ U.htmlName(i.name || '') %></a></td><td><%= i.sku %></td><td class="num"><%= U.money(i.price) %></td><td class="num"><%= U.num(i.qty) %></td><td><%= U.date.datetime(i.added_at) %></td><td><%= i.description || '' %></td></tr><% } %>
  </tbody></table></section>
<% } %>
</div>
</div>
